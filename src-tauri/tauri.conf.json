{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SERAPOD",
  "version": "0.8.4",
  "identifier": "app.serapod.desktop",
  "build": {
    "beforeDevCommand": "node node_modules/vite/bin/vite.js --host 127.0.0.1",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "node node_modules/vite/bin/vite.js build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "SERAPOD",
        "width": 1360,
        "height": 940,
        "minWidth": 850,
        "minHeight": 640,
        "backgroundColor": "#141619",
        "dragDropEnabled": false
      },
      {
        "label": "overlay",
        "url": "index.html?overlay",
        "title": "SERAPOD radial",
        "width": 560,
        "height": 560,
        "visible": true,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "focus": false,
        "focusable": false,
        "backgroundColor": "#00000000"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data:; connect-src ipc: http://ipc.localhost http://localhost:1420 ws://localhost:1420"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/icon.ico"
    ]
  }
}
